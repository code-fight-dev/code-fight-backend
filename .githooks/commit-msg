#!/usr/bin/env sh

message_file="$1"
first_line="$(sed -n '1p' "$message_file")"

case "$first_line" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|test|chore|deps)(\([a-z0-9._/-]+\))?!?: .+$'

if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

echo "Invalid commit message."
echo "Use semantic commits, for example:"
echo "  feat: add oauth callback handler"
echo "  refactor(auth): split session repository"
echo "  chore: wire migration bootstrap"
exit 1
